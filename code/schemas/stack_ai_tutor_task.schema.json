{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tutor.example/schemas/stack_ai_tutor_task.schema.json",
  "title": "STACK AI Tutor Task Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "status",
    "language",
    "topic",
    "subtopic",
    "question_text",
    "learning_goals",
    "student_inputs",
    "model_solution",
    "diagnoses",
    "tutor_policy",
    "hint_levels",
    "prompt_context_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_\\-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "published", "archived"]
    },
    "language": {
      "type": "string",
      "enum": ["de", "en"]
    },
    "topic": {
      "type": "string"
    },
    "subtopic": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "target_group": {
      "type": "string"
    },
    "question_text": {
      "type": "string"
    },
    "question_latex": {
      "type": "string"
    },
    "given_data": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "learning_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "student_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/student_input"
      }
    },
    "model_solution": {
      "$ref": "#/$defs/model_solution"
    },
    "diagnoses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/diagnosis"
      }
    },
    "tutor_policy": {
      "$ref": "#/$defs/tutor_policy"
    },
    "hint_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hint_level"
      }
    },
    "prompt_context_policy": {
      "$ref": "#/$defs/prompt_context_policy"
    }
  },
  "$defs": {
    "student_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "description"],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "algebraic_expression",
            "equation",
            "number",
            "matrix",
            "multiple_choice",
            "text"
          ]
        },
        "description": {
          "type": "string"
        },
        "variable": {
          "type": "string"
        },
        "syntax_examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "model_solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_answer", "solution_steps"],
      "properties": {
        "final_answer": {
          "type": "string"
        },
        "final_answer_latex": {
          "type": "string"
        },
        "solution_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/solution_step"
          }
        },
        "equivalent_forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "solution_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "description"],
      "properties": {
        "step_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "formula_latex": {
          "type": "string"
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "severity",
        "feedback_goal",
        "preferred_hint_strategy",
        "allowed_hint_levels"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["syntax", "minor", "procedural", "conceptual", "unknown"]
        },
        "feedback_goal": {
          "type": "string"
        },
        "concept_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid_phrases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preferred_hint_strategy": {
          "type": "string",
          "enum": [
            "conceptual_question",
            "worked_next_step",
            "syntax_hint",
            "compare_with_rule",
            "ask_to_check_specific_part"
          ]
        },
        "allowed_hint_levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "tutor_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tone",
        "max_words_first_hint",
        "max_words_later_hints",
        "do_not_give_final_answer_on_first_hint",
        "ask_activating_question",
        "use_student_answer",
        "language_level",
        "forbidden_behaviors"
      ],
      "properties": {
        "tone": {
          "type": "string"
        },
        "max_words_first_hint": {
          "type": "integer",
          "minimum": 20,
          "maximum": 200
        },
        "max_words_later_hints": {
          "type": "integer",
          "minimum": 20,
          "maximum": 400
        },
        "do_not_give_final_answer_on_first_hint": {
          "type": "boolean"
        },
        "ask_activating_question": {
          "type": "boolean"
        },
        "use_student_answer": {
          "type": "boolean"
        },
        "language_level": {
          "type": "string",
          "enum": ["simple", "standard", "advanced"]
        },
        "forbidden_behaviors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hint_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "name", "goal", "may_include", "must_not_include"],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "may_include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example_hint": {
          "type": "string"
        }
      }
    },
    "prompt_context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solution_step_limit_by_hint_level",
        "include_final_answer_from_hint_level",
        "treat_student_answer_as_untrusted"
      ],
      "properties": {
        "solution_step_limit_by_hint_level": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "include_final_answer_from_hint_level": {
          "type": "integer",
          "minimum": 1
        },
        "treat_student_answer_as_untrusted": {
          "type": "boolean"
        }
      }
    }
  }
}