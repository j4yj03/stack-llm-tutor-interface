# Beispielkonfiguration - nach code/.env kopieren und Werte anpassen.
# code/.env ist via .gitignore vom Commit ausgeschlossen.
# Niemals echte API-Keys oder Evaluationstokens committen.
# Die Einstellungen werden beim Prozessstart geladen; Aenderungen brauchen
# einen Serverneustart und fuer Evaluationsvergleiche eine neue Lauf-ID.
# Booleanwerte: 1/0, true/false, yes/no oder on/off; Gross-/Kleinschreibung egal.

# Backend fuer Tutor- und Judge-Aufrufe: saia (OpenAI-kompatibel, GWDG)
# oder ollama (nativer lokaler Ollama-Server). Keine automatische Modellfallbackwahl.
LLM_API_MODE=saia

# Basisadresse des gewaehlten Backends: SAIA mit /v1;
# fuer natives Ollama z.B. http://127.0.0.1:11434 ohne /v1.
LLM_BASE_URL=https://chat-ai.academiccloud.de/v1

# Providerkey fuer SAIA; lokal setzen, niemals loggen oder weitergeben.
# Bezugsquelle: https://saia.gwdg.de/dashboard. Lokales Ollama benoetigt keinen Key.
LLM_API_KEY=

# Defaultalias des Tutor-Modells, wenn im Request kein Modell angegeben ist.
# Muss beim Backend existieren; SAIA-Aliasse bei Bedarf mit GET /models pruefen.
LLM_MODEL=qwen3.8-27b

# Kommagetrennte erlaubte Request- und Judge-Modelle; keine beliebigen Aliasse.
# Leer verwendet die eingebaute Auswahl. LLM_MODEL wird immer zusaetzlich erlaubt.
LLM_ALLOWED_MODELS=qwen3.8-27b,qwen3.6-35b-a3b,qwen3.5-122b-a10b,gemma-4-31b-it,openai-gpt-oss-120b,mistral-medium-3.5-128b,glm-4.7,meta-llama-3.1-8b-instruct

# Timeout in Sekunden pro Providerrequest; positive Ganzzahl.
# Individuelle Startwahl und moegliche SAIA-Fallbacks koennen die Gesamtdauer erhoehen.
LLM_TIMEOUT=180

# Angeforderte Tutor-Temperatur: endliche Zahl 0..2; beeinflusst die Ausgabevariation.
# Fuer kontrollierte Vergleiche explizit festhalten, keine Qualitaetsgarantie.
LLM_TEMPERATURE=0.2

# Angeforderte maximale Ausgabetokens je Tutor-/Startauswahloperation: Ganzzahl 1..32768.
# Tokens sind keine Woerter; das didaktische Wortlimit wird separat konfiguriert.
LLM_MAX_TOKENS=400

# 1 fordert unterdruecktes Thinking an; 0 erlaubt es bzw. laesst SAIA-Erweiterung weg.
# Ollama sendet den umgekehrten think-Wert. Effektive Modellinternas bleiben unbekannt.
LLM_DISABLE_THINKING=1

# Endliche Wartezeit >=0 Sekunden vor dem einmaligen SAIA-Fallback ohne
# chat_template_kwargs bei Verbindungs-/HTTP-Fehlern, wenn das Feld gesendet wurde.
LLM_RETRY_DELAY=2

# SQLite-Pfad; relative Angaben beziehen sich auf das Arbeitsverzeichnis des Servers.
# Fuer Evaluation eine eigene Datei nutzen, z.B. data/tutor-evaluation.db.
DATABASE_PATH=data/tutor.db

# Maximale Zeichenanzahl der urspruenglichen Studierendenantwort; positive Ganzzahl.
MAX_STUDENT_ANSWER_LENGTH=2000

# Maximale Zeichenanzahl von Moodle-Volltext bzw. uebermittelter Funktion; positive Ganzzahl.
# Das gespeicherte JSON-Aufgabenlimit ist daraus abgeleitet und mindestens 10000.
MAX_QUESTION_TEXT_LENGTH=5000

# Maximale Zeichenanzahl einer Rueckfrage im HTML-Chat oder in der JSON-API; positive Ganzzahl.
MAX_CHAT_MESSAGE_LENGTH=2000

# Anzahl der zuletzt gespeicherten Nachrichten im Prompt; positive Ganzzahl.
# Kein Loesch-/Speicherlimit: Aeltere Nachrichten bleiben in der Datenbank.
MAX_HISTORY_MESSAGES=12

# Default-Kontextfelder fuer HTML und JSON-API, getrennt durch Komma oder Semikolon.
# Explizite API-Kontextoptionen ersetzen diese Defaults. Gueltige Namen
# mit/ohne Praefix include_: question_text, student_answer, diagnosis_code,
# prt_feedback, score, learning_goals, math_rules, solution_steps,
# final_answer, chat_history. Unbekannte Namen verhindern den Serverstart.
# Leer deaktiviert alle Felder. Loesungsfelder brauchen zusaetzlich Stufenfreigabe.
CONTEXT_OPTIONS=question_text,student_answer,diagnosis_code,prt_feedback,learning_goals,solution_steps,final_answer,chat_history

# Obergrenze fuer sichtbaren Kontext auf Stufe 0 und bei individueller Startwahl.
# Wird mit angeforderten Flags geschnitten, aktiviert nie ausgeschaltete Felder.
# Namen wie CONTEXT_OPTIONS; leer verbirgt alle Kontextfelder dieser Phase.
TUTOR_STAGE0_CONTEXT_OPTIONS=question_text,student_answer,learning_goals,math_rules,chat_history

# Nichtleeres Label der untersuchten Tutorregeln; wird im Public-Snapshot gespeichert.
# Identische Labels beweisen keine identischen Regeln; dafuer gilt der Konfigurationshash.
TUTOR_RULES_ID=default-policy

# Hoechste aktive Hilfestufe: Ganzzahl 0..32; Policy braucht alle Stufen 0..Maximum.
# Minimum ist fest 0. Bei Maximum 0 auch Startstufe und Adaptionsmaximum auf 0 setzen.
MAX_HINT_LEVEL=4

# Feste Startstufe fuer neue Sessions ohne explizite Stufenwahl im Modus fixed.
# Bereich 0..MAX_HINT_LEVEL; 0 ist eine Diagnosefrage, keine empirisch optimale Baseline.
TUTOR_START_LEVEL=1

# fixed nutzt TUTOR_START_LEVEL; individual fuehrt vorher eine weitere LLM-Auswahl aus.
# Ein explizites hint_level im Request hat Vorrang und umgeht die Startauswahl.
TUTOR_START_MODE=fixed

# provided nutzt gegebenen Fehlerkontext; model erlaubt eine unsichere eigene Hypothese;
# none fordert keine Diagnose. model/none entfernen gelieferte Diagnose und Feedback.
# Synthetische Labels und Modellhypothesen sind keine verifizierten PRT-Ergebnisse.
TUTOR_DIAGNOSIS_MODE=provided

# tutor verwendet didaktische Rollen-/Stufenregeln; general den allgemeinen Assistenten.
# Inputisolation, mathematische Autoritaet und doppelte Referenzfreigabe bleiben erhalten.
TUTOR_POLICY_MODE=tutor

# text gibt freien Hinweistext aus; structured verlangt JSON mit hint und diagnosis_hypothesis.
# Eine String-Hypothese ist nur im Diagnosemodus model erlaubt; gespeichert wird der Hint.
TUTOR_RESPONSE_FORMAT=text

# 1 fordert im Tutormodus eine aktivierende Rueckfrage; 0 entfernt diese Zusatzregel.
# Die diagnostische Einstiegsfrage auf Stufe 0 bleibt davon unabhaengig.
TUTOR_ASK_ACTIVATING_QUESTION=1

# 1 verbietet dem Tutor die Nennung interner Hilfestufen; 0 entfernt diese Promptregel.
# Steuert nicht die HTML-Debuganzeige; dafuer gilt DEBUG_MODE.
TUTOR_HIDE_HINT_LEVEL=1

# 1 aktiviert im Tutormodus das max_words-Promptlimit und den passenden Evaluationscheck.
# 0 deaktiviert diese Regel; kein serverseitiges Abschneiden oder Produktionsoutputfilter.
TUTOR_ENFORCE_WORD_LIMIT=1

# 1 erlaubt adaptive Erhoehung bei der naechsten Chatinteraktion; 0 deaktiviert sie.
# Zeitgrenze UND Verwirrungssignal erforderlich; kein Timer oder autonomer LLM-Aufruf.
TUTOR_ADAPTIVE_ENABLED=0

# Endliche Zeitgrenze >=0 Sekunden seit der letzten erfolgreichen Tutorantwort.
# Monoton nur im selben Prozess messbar; keine aktive Lernzeit, nach Neustart unbekannt.
TUTOR_ADAPTIVE_AFTER_SECONDS=120

# Anzahl der Stufen je adaptiver Erhoehung; positive Ganzzahl, durch Maximum begrenzt.
TUTOR_ADAPTIVE_STEP=1

# Hoechste durch Adaption erreichbare Stufe: Ganzzahl 0..MAX_HINT_LEVEL.
# Senkt eine bereits hoehere Stufe nicht; explizite Stufenwahl kann darueber hinausgehen.
TUTOR_ADAPTIVE_MAX_LEVEL=4

# Selbstbericht-Phrasen als Verwirrungssignal, getrennt durch Komma oder Semikolon.
# Gross-/Kleinschreibung und Umlaute werden normalisiert; leer deaktiviert Phrasentreffer.
# Ein Treffer ist ein Signal, kein bewiesener Wissensstand; Zeit allein reicht nicht.
TUTOR_ADAPTIVE_CONFUSION_PHRASES=ich verstehe nicht,keine ahnung,ich weiss nicht,no idea

# Datei der generischen Stufenpolicy; absolut oder relativ zu code/, nicht zum Prozess-CWD.
# Alle aktiven Stufen 0..MAX_HINT_LEVEL mit Pflichtfeldern erforderlich; kein Hot-Reload.
HINT_LEVELS_PATH=config/hint_levels.json

# Optionales JSON-Objekt mit partiellen/vollen Overrides bereits vorhandener Stufen.
# Leer nutzt die Datei unveraendert. Reihenfolge: Datei, JSON, einzelne TUTOR_LEVEL-Felder.
# Texte sind Daten, keine Templates/Pythonausdruecke; ungueltige Werte verhindern den Start.
TUTOR_HINT_POLICY_JSON=

# Deaktiviertes Beispiel: Wortlimit und Ziel von Stufe 1 gemeinsam ueberschreiben.
# TUTOR_HINT_POLICY_JSON='{"1":{"max_words":60,"goal":"Ein Konzept aktivieren."}}'

# Einzel-Overrides sind deaktivierte Beispiele; zum Verwenden Kommentarzeichen entfernen.
# Die 1 im Namen kann durch jede bereits vorhandene Stufe ersetzt werden, auch 0.

# Kurzname der Stufe als nichtleerer woertlicher Text, ohne aufgabenspezifische Inhalte.
# TUTOR_LEVEL_1_NAME=Orientierung

# Generisches Stufenziel als nichtleerer Text; geht bei aktiver Tutorpolicy in den Prompt.
# TUTOR_LEVEL_1_GOAL=Das relevante Konzept aktivieren.

# Didaktisches Wortlimit dieser Stufe als positive JSON-Ganzzahl.
# TUTOR_LEVEL_1_MAX_WORDS=70

# Maximale Anzahl geordneter Referenzschritte: JSON-Ganzzahl >=0 oder null fuer alle.
# TUTOR_LEVEL_1_MAX_SOLUTION_STEPS=0

# Stufenfreigabe fuer Referenzschritte: Boolean; braucht auch die passende Kontextoption.
# TUTOR_LEVEL_1_INCLUDE_SOLUTION_STEPS=0

# Stufenfreigabe fuer die Referenzendloesung: Boolean; Kontextfreigabe bleibt ebenfalls noetig.
# TUTOR_LEVEL_1_INCLUDE_FINAL_ANSWER=0

# Erlaubte Inhalte als JSON-Liste nichtleerer Texte; leere Liste [] ist erlaubt.
# Alternativ Komma/Semikolon verwenden; generische Beschreibung statt Taskformeln.
# TUTOR_LEVEL_1_MAY_INCLUDE='["eine aktivierende Frage"]'

# Verbotene Inhalte als JSON-Liste nichtleerer Texte; Format wie MAY_INCLUDE.
# Ein anderer Listentext umgeht nicht die technische doppelte Referenzfreigabe.
# TUTOR_LEVEL_1_MUST_NOT_INCLUDE='["Endergebnis"]'

# 1 aktiviert geschuetzte /api/evaluation/config- und /judge-Routen; 0 liefert dort 404.
# Aktivierung braucht einen nichtleeren Token und erzeugt selbst keine Modellaufrufe.
EVALUATION_API_ENABLED=0

# Serversecret fuer Header X-Evaluation-Token; leer nur bei deaktivierten Evalrouten erlaubt.
# Der Client setzt denselben Wert lokal als TUTOR_EVALUATION_TOKEN, nie im Notebook/URL.
EVALUATION_API_TOKEN=

# Expliziter Judgealias aus LLM_ALLOWED_MODELS; leer laesst die Modellbewertung unkonfiguriert.
# Das Evaluationswerkzeug verlangt einen anderen Alias als den Generator, kein Unabhaengigkeitsbeweis.
EVALUATION_JUDGE_MODEL=

# Angeforderte Judge-Temperatur: endliche Zahl 0..2, getrennt von LLM_TEMPERATURE.
# 0 bevorzugt geringere Variation, garantiert aber keine deterministischen Bewertungen.
EVALUATION_JUDGE_TEMPERATURE=0.0

# Maximale angeforderte Judge-Ausgabetokens: Ganzzahl 1..32768, getrennt vom Tutorlimit.
# Genuegend Platz fuer Ratings/Begruendungen einplanen; JSON gueltig heisst nicht fachlich richtig.
EVALUATION_JUDGE_MAX_TOKENS=1200

# Debug-Modus der Tutor-Seite: 1 (Entwicklung) zeigt den einklappbaren
# Debug-Bereich (Hilfestufen-Dropdown, STACK-Diagnose, Prompt-/Options-
# Debugger); 0 blendet ihn fuer Studierende komplett aus.
# Aendert weder den LLM-Kontext noch JSON-Debugfelder und ist keine Zugriffskontrolle.
DEBUG_MODE=1
