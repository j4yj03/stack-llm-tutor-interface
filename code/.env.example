# Beispielkonfiguration - nach code/.env kopieren und Werte anpassen.
# code/.env ist via .gitignore vom Commit ausgeschlossen.
# Niemals echte API-Keys committen.

# Backend: saia (OpenAI-kompatibel, GWDG) | ollama (nativer Ollama-Server)
LLM_API_MODE=saia

# SAIA: https://chat-ai.academiccloud.de/v1
LLM_BASE_URL=https://chat-ai.academiccloud.de/v1

# API-Key nur hier setzen (lokal), siehe https://saia.gwdg.de/dashboard
LLM_API_KEY=

# Default-Modell, z.B. qwen3.8-27b, qwen3.6-35b-a3b, gemma-4-31b-it
# Aktuelle Modellliste: GET {LLM_BASE_URL}/models
LLM_MODEL=qwen3.8-27b

# Kommagetrennte Allowlist der auswahlbaren Modelle
LLM_ALLOWED_MODELS=qwen3.8-27b,qwen3.6-35b-a3b,qwen3.5-122b-a10b,gemma-4-31b-it,openai-gpt-oss-120b,mistral-medium-3.5-128b,glm-4.7,meta-llama-3.1-8b-instruct

LLM_TIMEOUT=180

# Wartezeit (Sekunden) vor dem automatischen Fallback-Versuch ohne
# chat_template_kwargs, falls das Gateway Chat-Aufrufe mit HTTP 5xx abweist.
LLM_RETRY_DELAY=2

DATABASE_PATH=data/tutor.db
MAX_STUDENT_ANSWER_LENGTH=2000
MAX_QUESTION_TEXT_LENGTH=5000
MAX_CHAT_MESSAGE_LENGTH=2000
MAX_HISTORY_MESSAGES=12
