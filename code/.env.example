# Beispielkonfiguration - nach code/.env kopieren und Werte anpassen.
# code/.env ist via .gitignore vom Commit ausgeschlossen.
# Niemals echte API-Keys committen.

# Backend: saia (OpenAI-kompatibel, GWDG) | ollama (nativer Ollama-Server)
LLM_API_MODE=saia

# SAIA: https://chat-ai.academiccloud.de/v1
LLM_BASE_URL=https://chat-ai.academiccloud.de/v1

# API-Key nur hier setzen (lokal), siehe https://saia.gwdg.de/dashboard
LLM_API_KEY=

# Default-Modell, z.B. qwen3.8-27b, qwen3.6-35b-a3b, gemma-4-31b-it
# Aktuelle Modellliste: GET {LLM_BASE_URL}/models
LLM_MODEL=qwen3.8-27b

# Kommagetrennte Allowlist der auswahlbaren Modelle
LLM_ALLOWED_MODELS=qwen3.8-27b,qwen3.6-35b-a3b,qwen3.5-122b-a10b,gemma-4-31b-it,openai-gpt-oss-120b,mistral-medium-3.5-128b,glm-4.7,meta-llama-3.1-8b-instruct

LLM_TIMEOUT=180
LLM_TEMPERATURE=0.2
# Token limits: positive integers, at most 32768. Temperatures: finite, 0..2.
LLM_MAX_TOKENS=400
LLM_DISABLE_THINKING=1

# Wartezeit (Sekunden) vor dem automatischen Fallback-Versuch ohne
# chat_template_kwargs, falls das Gateway Chat-Aufrufe mit HTTP 5xx abweist.
LLM_RETRY_DELAY=2

DATABASE_PATH=data/tutor.db
MAX_STUDENT_ANSWER_LENGTH=2000
MAX_QUESTION_TEXT_LENGTH=5000
MAX_CHAT_MESSAGE_LENGTH=2000
MAX_HISTORY_MESSAGES=12

# Aktive Kontextoptionen der Tutor-Flows (Kommagetrennt). Gueltige Namen
# mit/ohne Praefix include_: question_text, student_answer, diagnosis_code,
# prt_feedback, score, learning_goals, math_rules, solution_steps,
# final_answer, chat_history. Unbekannte Namen verhindern den Serverstart.
# Diese Werte sind auch die Defaultwerte der JSON-API (ContextOptions).
CONTEXT_OPTIONS=question_text,student_answer,diagnosis_code,prt_feedback,learning_goals,solution_steps,final_answer,chat_history

# Stage 0 caps requested options; it never enables a disabled request field.
# Names and include_ prefixes match CONTEXT_OPTIONS; an empty list hides all.
TUTOR_STAGE0_CONTEXT_OPTIONS=question_text,student_answer,learning_goals,math_rules,chat_history

# Generic pedagogical conditions, recorded in the public configuration.
# Modes: fixed|individual, provided|model|none, tutor|general, text|structured.
# A model diagnosis is only an uncertain hypothesis, never mathematical grading.
# model/none suppress supplied diagnosis and feedback from the effective context.
TUTOR_RULES_ID=default-policy
# MIN_HINT_LEVEL is fixed at 0, not an environment override.
MAX_HINT_LEVEL=4
TUTOR_START_LEVEL=1
TUTOR_START_MODE=fixed
TUTOR_DIAGNOSIS_MODE=provided
TUTOR_POLICY_MODE=tutor
TUTOR_RESPONSE_FORMAT=text
TUTOR_ASK_ACTIVATING_QUESTION=1
TUTOR_HIDE_HINT_LEVEL=1
TUTOR_ENFORCE_WORD_LIMIT=1

# Passive adaptation controls; loading configuration never starts a timer/call.
TUTOR_ADAPTIVE_ENABLED=0
TUTOR_ADAPTIVE_AFTER_SECONDS=120
TUTOR_ADAPTIVE_STEP=1
TUTOR_ADAPTIVE_MAX_LEVEL=4
TUTOR_ADAPTIVE_CONFUSION_PHRASES=ich verstehe nicht,keine ahnung,ich weiss nicht,no idea

# Relative paths resolve against code/, independently of the working directory.
# Required active policy levels: 0..MAX_HINT_LEVEL. Stage 0 is diagnostic by default.
HINT_LEVELS_PATH=config/hint_levels.json
# JSON object: partial or full overrides of existing levels, then per-field overrides.
# No templates or Python expressions are evaluated. Invalid overrides fail startup.
TUTOR_HINT_POLICY_JSON=
# TUTOR_HINT_POLICY_JSON='{"1":{"max_words":60,"goal":"Ein Konzept aktivieren."}}'
# All fields can be overridden for each existing level, e.g. TUTOR_LEVEL_0_GOAL.
# Text: NAME, GOAL; integers: MAX_WORDS, MAX_SOLUTION_STEPS (or null for all steps).
# Booleans: INCLUDE_SOLUTION_STEPS, INCLUDE_FINAL_ANSWER.
# Lists: MAY_INCLUDE, MUST_NOT_INCLUDE, preferably JSON (comma/semicolon also valid).
# TUTOR_LEVEL_1_NAME=Orientierung
# TUTOR_LEVEL_1_GOAL=Das relevante Konzept aktivieren.
# TUTOR_LEVEL_1_MAX_WORDS=70
# TUTOR_LEVEL_1_MAX_SOLUTION_STEPS=0
# TUTOR_LEVEL_1_INCLUDE_SOLUTION_STEPS=0
# TUTOR_LEVEL_1_INCLUDE_FINAL_ANSWER=0
# TUTOR_LEVEL_1_MAY_INCLUDE='["eine aktivierende Frage"]'
# TUTOR_LEVEL_1_MUST_NOT_INCLUDE='["Endergebnis"]'

# Evaluation endpoints require X-Evaluation-Token when enabled.
# The judge model has no implicit default; select an allowed model before use.
# These settings do not dispatch requests. Never commit real tokens or keys.
EVALUATION_API_ENABLED=0
EVALUATION_API_TOKEN=
EVALUATION_JUDGE_MODEL=
EVALUATION_JUDGE_TEMPERATURE=0.0
EVALUATION_JUDGE_MAX_TOKENS=1200

# Debug-Modus der Tutor-Seite: 1 (Entwicklung) zeigt den einklappbaren
# Debug-Bereich (Hilfestufen-Dropdown, STACK-Diagnose, Prompt-/Options-
# Debugger); 0 blendet ihn fuer Studierende komplett aus.
DEBUG_MODE=1
